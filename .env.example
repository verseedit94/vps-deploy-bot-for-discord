# VerseVPS - Made by Verseedit
# install.sh creates .env for you (it asks for the token and your admin ID).
DISCORD_TOKEN=your-bot-token
# Comma-separated Discord user IDs of admins (more can be added with !useraccess @user)
ADMIN_IDS=123456789012345678

# --- optional ---
PANEL_PORT=5000
# Public dashboard URL. Auto-detected (server IP, or Replit/Codespaces/Gitpod/CodeSandbox URL).
# You can also change it from Discord:  !panelurl https://example.com
#PANEL_URL=
# auto | lxd | docker | proc   (auto = best one that works on this machine)
BACKEND=auto
# 1 = a VPS is only created when users can get ROOT (needs Docker or LXD). 0 = also allow the rootless sandbox.
REQUIRE_ROOT=1
# Host name shown inside every VPS (root@verseedit)
VPS_HOSTNAME=verseedit
# SSH: every VPS gets one public port from this range (open it in your firewall / cloud security group)
SSH_PORT_START=20000
SSH_PORT_END=29999
# Address shown for SSH (default: the server's public IP)
#SSH_HOST=
# Starting values of the !deploy plan (admins change it live with  !deployedit <ram> <ssd> <cpu> [per_user])
DEPLOY_RAM=2GB
DEPLOY_DISK=10GB
DEPLOY_CPU=0.5
DEPLOY_PER_USER=1
# Host RAM / SSD / CPU are detected automatically (container limits included). 1.0 = never give out more than the
# host has. A safety reserve for the host is automatic too (RESERVE_RAM_MB / RESERVE_DISK_MB only to override).
RAM_OVERCOMMIT=1.0
DISK_OVERCOMMIT=1.0
CPU_OVERCOMMIT=1.0
MAX_UPLOAD_MB=4096
# Web-terminal time limit per command (seconds)
CMD_TIMEOUT=300
# Extra `docker run` flags for every VPS, e.g. --cap-add=NET_ADMIN (more power = less isolation)
#DOCKER_EXTRA_ARGS=
